#!/usr/bin/env bash
#MISE description="Branch release/vX.Y.Z from main, bump the version (patch|minor|major), relock, update doc version refs, commit and push"
#USAGE arg "<bump>" help="patch, minor or major" {
#USAGE   choices "patch" "minor" "major"
#USAGE }
set -euo pipefail

bump=${usage_bump:?}

if [ -n "$(git status --porcelain)" ]; then
  echo "Working tree not clean; commit or stash first" >&2
  exit 1
fi

git fetch origin --tags
git switch main
git merge --ff-only origin/main

name=$(uv run python -c "import tomllib; print(tomllib.load(open('pyproject.toml','rb'))['project']['name'])")
old_version=$(uv version --short)
version=$(uv version --bump "$bump" --dry-run --short)
branch="release/v$version"
if git rev-parse -q --verify "refs/tags/v$version" >/dev/null; then
  echo "Tag v$version already exists" >&2
  exit 1
fi
if git ls-remote --exit-code --heads origin "$branch" >/dev/null; then
  echo "Branch $branch already exists on origin" >&2
  exit 1
fi

git switch -c "$branch"
# Rewrites pyproject.toml and relocks uv.lock; --no-sync leaves .venv alone
uv version --bump "$bump" --no-sync

# Install commands and wheel names in the user docs name the release
# (`<name>.git@vX.Y.Z`, `<name>-X.Y.Z`, `<name>==X.Y.Z`); the rest of docs/ is left as written.
NAME="$name" OLD="$old_version" NEW="$version" perl -pi -e \
  's/(\Q$ENV{NAME}\E(?:\.git\@v|-|==| ))\Q$ENV{OLD}\E\b/$1$ENV{NEW}/g' \
  README.md docs/user/*.md

unexpected=$(git status --porcelain | grep -vE '^ M (pyproject\.toml|uv\.lock|README\.md|docs/user/[^/]+\.md)$' || true)
if [ -n "$unexpected" ]; then
  echo "Unexpected changes after bump:" >&2
  echo "$unexpected" >&2
  exit 1
fi

git add pyproject.toml uv.lock README.md docs/user
git commit -m "chore: release $version"
git push -u origin "$branch"
echo "Prepared $branch"
