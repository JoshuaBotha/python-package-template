#!/usr/bin/env bash
#MISE description="Install the built wheel into a clean venv and check it imports"
#MISE depends=["build:dist"]
set -euo pipefail

module=$(uv run python -c "import tomllib; print(tomllib.load(open('pyproject.toml','rb'))['project']['name'].replace('-', '_'))")

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

uv venv --quiet "$tmp/venv"
# A Windows venv keeps its interpreter in Scripts/, not bin/.
py="$tmp/venv/bin/python"
[ -x "$py" ] || py="$tmp/venv/Scripts/python.exe"
uv pip install --quiet --python "$py" dist/*.whl

# Run away from the repo so the installed wheel is what imports.
(cd "$tmp" && "$py" -c "import $module; print('wheel ok:', $module.__version__)")
