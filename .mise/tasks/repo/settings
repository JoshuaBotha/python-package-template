#!/usr/bin/env bash
#MISE description="Apply GitHub repo settings: features, merge rules, main ruleset (idempotent). Args: any of features merge ruleset (default: all)"
set -euo pipefail

steps=("$@")
[ ${#steps[@]} -gt 0 ] || steps=(features merge ruleset)

repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
want() { printf '%s\n' "${steps[@]}" | grep -qx "$1"; }
# Some features need a public repo or a paid plan for private ones; warn and go on.
try() { "$@" >/dev/null 2>&1 || echo "  skipped (not available for this repo/plan): ${*:1:4}" >&2; }

if want features; then
  echo "==> Features and security"
  gh api -X PATCH "repos/$repo" -F has_wiki=false -F has_projects=false >/dev/null
  try gh api -X PATCH "repos/$repo" --input - <<'JSON'
{
  "security_and_analysis": {
    "secret_scanning": {"status": "enabled"},
    "secret_scanning_push_protection": {"status": "enabled"}
  }
}
JSON
  try gh api -X PUT "repos/$repo/vulnerability-alerts"
  try gh api -X PUT "repos/$repo/private-vulnerability-reporting"
  # Topics come from [project].keywords in pyproject.toml.
  topics=$(uv run python -c "import json, re, tomllib; kw = tomllib.load(open('pyproject.toml','rb'))['project'].get('keywords', []); print(json.dumps({'names': [re.sub('[^a-z0-9-]', '-', k.lower()) for k in kw]}))")
  echo "$topics" | gh api -X PUT "repos/$repo/topics" --input - >/dev/null
fi

if want merge; then
  echo "==> Merge settings (squash only, PR title, delete branches)"
  gh api -X PATCH "repos/$repo" --input - >/dev/null <<'JSON'
{
  "allow_squash_merge": true,
  "allow_merge_commit": false,
  "allow_rebase_merge": false,
  "squash_merge_commit_title": "PR_TITLE",
  "squash_merge_commit_message": "BLANK",
  "delete_branch_on_merge": true
}
JSON
fi

if want ruleset; then
  echo "==> Ruleset: main-protection"
  body=$(cat <<'JSON'
{
  "name": "main-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
  "bypass_actors": [
    {"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}
  ],
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "pull_request", "parameters": {
      "required_approving_review_count": 0,
      "dismiss_stale_reviews_on_push": false,
      "require_code_owner_review": false,
      "require_last_push_approval": false,
      "required_review_thread_resolution": false
    }},
    {"type": "required_status_checks", "parameters": {
      "strict_required_status_checks_policy": true,
      "required_status_checks": [
        {"context": "ci (ubuntu-latest)"},
        {"context": "ci (macos-latest)"},
        {"context": "ci (windows-latest)"}
      ]
    }}
  ]
}
JSON
)
  # A 403 (plan-gated) prints its error body to stdout, so keep only a numeric id.
  if ! list=$(gh api "repos/$repo/rulesets" --jq '.[] | select(.name=="main-protection") | .id' 2>/dev/null); then
    echo "  Rulesets need a public repo or a paid plan for private ones; main is unprotected." >&2
    echo "Done."
    exit 0
  fi
  id=$(printf '%s\n' "$list" | grep -E '^[0-9]+$' | head -1 || true)
  if [ -n "$id" ]; then
    echo "$body" | gh api -X PUT "repos/$repo/rulesets/$id" --input - >/dev/null
  elif ! echo "$body" | gh api -X POST "repos/$repo/rulesets" --input - >/dev/null; then
    echo "  Rulesets need a public repo or a paid plan for private ones; main is unprotected." >&2
  fi
fi

echo "Done."
